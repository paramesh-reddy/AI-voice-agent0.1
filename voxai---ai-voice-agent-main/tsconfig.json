{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmit": true,
    "moduleDetection": "force",
    "resolveJsonModule": true
  },
  "include": ["server.ts", "backend/src/**/*.ts"],
  "exclude": ["dist", "frontend", "node_modules"]
}
